GATEWAY_PORT=8000
LIBRARY_PORT=8001
KNOWLEDGE_PORT=8002
MOCK_EQMS_PORT=8003
WORKFLOW_PORT=8004
WEB_PORT=5173
# Comma-separated hosts the gateway may call. Empty = no egress.
GATEWAY_ALLOWLIST=

# Local LLM (Ollama) - INTERNAL service, reachable only through the gateway, never on the external allow-list.
# The model name and generation settings are NOT set here: they live in gateway/config/ai_config.json (change control).
OLLAMA_URL=http://127.0.0.1:11434
WORKFLOW_URL=http://127.0.0.1:8004
